.build/
*.pkg
*.tar.gz
# Never commit Apple SDK/toolchain bytes or built runtime binaries.
*.dylib
# macOS + tooling cruft (baseline parity with the other mavericks-* repos)
._*
.DS_Store
.superpowers/
docs/
/VERSION
/UPSTREAM_VERSION

# Default build root is $MAVERICKS_BUILD_ROOT (outside the tree); build/, out/, work/ (with its
# nested stdlib-build/), and dist/ are only the deliberate-in-tree escape hatch
# (MAVERICKS_BUILD_ROOT="$PWD" ./build.sh).
/swift-runtime-cross/
