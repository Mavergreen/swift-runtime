# pins.env — single source of truth for every pinned input.
# Sourced by build-llvm.sh, mirror-toolchain.sh, package.sh, verify-relocatable.sh.
# Do NOT float these: the Swift stdlib is coupled to its compiler.
# The ONE authoritative Swift pin. Everything below derives from it, so a bump touches one line
# and cannot leave the tag or the URL behind (they used to repeat "6.3.3" four times between them).
SWIFT_VERSION="6.4.0"   # renovate: swiftlang/swift
SWIFT_TAG="swift-${SWIFT_VERSION}-RELEASE"
SWIFT_SHA="b8189d766d86ad7fc8106787d6ce9e402f38dd72"          # commit at SWIFT_TAG; Renovate moves it with SWIFT_VERSION
LLVM_BRANCH="swift/release/6.4.0"
LLVM_SHA="903b9faaae5c43ecc9b7e33f8db9c94c7429374a"           # swiftlang/llvm-project @ swift/release/6.4.0
TOOLCHAIN_URL="https://download.swift.org/swift-${SWIFT_VERSION}-release/xcode/${SWIFT_TAG}/${SWIFT_TAG}-osx.pkg"
# The toolchain .pkg is verified by its SIGNATURE, not by a pinned hash. A hash can only vouch for
# bytes someone has already seen, so every version bump needed a human to paste a new one -- the one
# thing keeping Swift updates off the automated path. The signing identity is stable across releases,
# so this verifies a version that does not exist yet. Upstream publishes no GPG .sig for the macOS
# .pkg (that URL 404s); the .pkg is an Apple-signed installer, so pkgutil is the check that exists.
TOOLCHAIN_SIGNER="Developer ID Installer: Swift Open Source (V9AUD2URP3)"
DEPLOYMENT="10.9"
ARCH="x86_64"
HOST_ARCH="$(uname -m)"                                      # labels the tarball; must describe the machine that built it

# ---- derived asset names -----------------------------------------------------
# Defined ONCE here because package.sh writes these names and verify-relocatable.sh
# reads them back; computing them separately in each script is how the two silently
# drift apart. Requires the sourcing script to have set HERE (all of them do).
# The full <upstream>-mavericks.N. DERIVED, never committed: UPSTREAM_VERSION (written from the
# SWIFT_VERSION pin above by scripts/derive-upstream-version.sh) plus the shipped tags decide it.
# The committed VERSION this replaces needed a hand-edit before every tag -- a commit to main that
# branch protection denies to bots, which is why this repo never auto-released.
[ -f "$HERE/UPSTREAM_VERSION" ] || sh "$HERE/scripts/derive-upstream-version.sh" >/dev/null
. "$HERE/msc.sh"        # -> $SHIPYARD; sourced here because VERSION below comes from a shared script
VERSION="$(MAVERICKS_ROOT="$HERE" sh "$SHIPYARD/resolve-version.sh")"
# Built here, so it carries the repo name and version: <repo>-<VERSION>-<platform>.
# The platform suffix is load-bearing -- HOST_ARCH describes the machine that built
# the TableGen binaries, and an arm64 tree labelled x86_64 fails confusingly.
BUILDSUPPORT_ASSET="swift-toolchain-$VERSION-macos-$HOST_ARCH.tar.gz"
# Mirrored, not built: keeps upstream's filename so the correspondence with
# download.swift.org stays checkable, prefixed to make its nature obvious.
TOOLCHAIN_ASSET="upstream-swift-$SWIFT_VERSION-RELEASE-osx.pkg"
