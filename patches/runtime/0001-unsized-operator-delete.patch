diff --git CMakeLists.txt CMakeLists.txt
index f91dfeac..d444d402 100644
--- CMakeLists.txt
+++ CMakeLists.txt
@@ -870,7 +870,11 @@ if(CMAKE_CXX_COMPILER_ID MATCHES Clang)
   check_cxx_compiler_flag("-fsized-deallocation"
     CXX_SUPPORTS_FSIZED_DEALLOCATION)
   if(CXX_SUPPORTS_FSIZED_DEALLOCATION)
-    add_compile_options($<$<COMPILE_LANGUAGE:CXX>:-fsized-deallocation>)
+    # Mavericks 10.9: 10.9's libc++ does not export sized operator delete
+    # (__ZdlPvm). Emit the unsized operator delete (__ZdlPv, present on 10.9)
+    # instead. Safe here because IRGen (the only consumer that needs sized
+    # deallocation) is not built in this stdlib-only configuration.
+    add_compile_options($<$<COMPILE_LANGUAGE:CXX>:-fno-sized-deallocation>)
   endif()
 endif()
 
