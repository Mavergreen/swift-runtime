+// Mavericks 10.9 minimal in-runtime class realization (verdict (A), cut #1).
+//
+// On macOS 10.9 objc_readClassPair (10.11) is absent, so runtime-instantiated
+// generic classes are never realized by objc-228 — objc reads their data() as an
+// unrealized ro and crashes. Struct analysis (SPIKE-ro-compat-FINDINGS.md) shows
+// objc4-532.2's class layout reconciles with modern Swift's: class_ro_t is
+// byte-identical, the class data pointer sits at the same offset (32), and objc's
+// class_t occupies only the first 40 bytes (the ObjC-interop prefix), so writing
+// an rw pointer + empty cache/vtable there does not collide with Swift-live
+// metadata (which begins after offset 40). So we replicate objc4-532's
+// realizeClass CORE here: allocate a class_rw_t in objc-532's layout, point it at
+// the existing ro, mark RW_REALIZED, install empty cache/vtable, and swap
+// data()->rw (preserving the Swift is-swift low bits, exactly as objc-532 setData
+// does). This makes the class objc-readable/realized on 10.9 without needing the
+// missing SPI. NEEDS validation on real 10.9 (100x + libgmalloc); cannot be
+// exercised on a modern-objc host.
+namespace {
+struct mav_class_rw_t {          // objc4-532.2 class_rw_t (x86_64) — 48 bytes
+  uint32_t flags;
+  uint32_t version;
+  const void *ro;
+  void *method_list_or_lists;
+  void *properties;
+  const void *protocols;
+  void *firstSubclass;
+  void *nextSiblingClass;
+};
+struct mav_class_t {             // objc4-532.2 class_t (x86_64) — 40 bytes
+  struct mav_class_t *isa;       // 0
+  struct mav_class_t *superclass;// 8
+  void *cache;                   // 16
+  void *vtable;                  // 24
+  uintptr_t data_NEVER_USE;      // 32  (data() = & ~3)
+};
+} // namespace
+#define MAV_RW_REALIZED (1u << 31)
+// Both are OBJC_EXPORT in libobjc and present on 10.9 (objc-228).
+extern "C" struct objc_cache _objc_empty_cache;
+extern "C" void *_objc_empty_vtable;
+
+static void mav_minimalRealize(void *clsPtr) {
+  auto *cls = reinterpret_cast<mav_class_t *>(clsPtr);
+  if (!cls) return;
+  uintptr_t data = cls->data_NEVER_USE;
+  auto *maybeRW = reinterpret_cast<mav_class_rw_t *>(data & ~(uintptr_t)3);
+  // Unrealized classes have data()->ro; ro->flags never has bit 31 set, so this
+  // correctly reports "not realized" for the ro case and skips already-realized.
+  if (maybeRW && (maybeRW->flags & MAV_RW_REALIZED))
+    return;
+  const void *ro = maybeRW;                       // data() currently points at ro
+  auto *rw = reinterpret_cast<mav_class_rw_t *>(calloc(1, sizeof(mav_class_rw_t)));
+  rw->flags = MAV_RW_REALIZED;                    // single method_list (no RW_METHOD_ARRAY)
+  rw->version = 0;
+  rw->ro = ro;
+  cls->cache = &_objc_empty_cache;
+  cls->vtable = &_objc_empty_vtable;
+  // setData, preserving the Swift is-swift low bits (objc-532 masks them off).
+  cls->data_NEVER_USE = reinterpret_cast<uintptr_t>(rw) | (data & (uintptr_t)3);
+}
