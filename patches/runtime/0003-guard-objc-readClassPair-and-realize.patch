+  // Register the class in-place with the Objective-C runtime.
+  //
+  // Mavericks 10.9: objc_readClassPair() is a macOS 10.11 SPI. On 10.9/10.10 it
+  // is absent, and 10.9's dyld aborts on the missing weak call. Guard it. When
+  // present (>=10.11) register in-place as usual. When absent, skip Objective-C
+  // registration entirely: the runtime-instantiated (typically generic) class
+  // metadata built by the Swift runtime is already self-consistent for native
+  // Swift use (vtable dispatch, native reference counting) — this mirrors how
+  // swift_instantiateObjCClass is a no-op on non-ObjC-interop platforms. The
+  // class is simply not visible to the Objective-C class tables (objc_getClass
+  // by name, category attachment), which these internal generic classes do not
+  // rely on. Field offsets were already computed and stored by the caller before
+  // this point, so layout is unaffected.
+  bool haveReadClassPair = SWIFT_RUNTIME_WEAK_CHECK(objc_readClassPair);
+
+  // Realize the class so the Objective-C runtime can read/message it.
+  if (haveReadClassPair) {
+    Class registered = SWIFT_RUNTIME_WEAK_USE(objc_readClassPair(c, &ImageInfo));
+    assert(registered == c
+           && "objc_readClassPair failed to instantiate the class in-place");
+    (void)registered;
+  } else {
+    // 10.9 path (objc_readClassPair absent): minimal in-runtime realization of
+    // the class and its metaclass. See mav_minimalRealize above.
+    mav_minimalRealize(c);
+    mav_minimalRealize(object_getClass(c));
+  }
