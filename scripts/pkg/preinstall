#!/bin/sh
# ONE-TIME MIGRATION off the ModernMavericks identity (flag day 2026-09-22).
# DELETABLE once no pre-flag-day install survives (see shipyard SKILL.md "Consolidation backlog"),
# together with the two lines in package.sh that ship it and tests/flag-day-preinstall-test.sh.
#
# The pkg identifier moved from dev.modernmavericks.swift-runtime to dev.mavergreen.swift-runtime,
# and to Installer a different identifier is a different package: nothing it did under the old one is
# undone by installing this. What that leaves, and who handles it:
#   - /usr/lib/swift/*.dylib: same path, overwritten by this payload.
#   - the old SwiftUpdater.app and its dev.modernmavericks.swift-updatecheck agent: retired by
#     shipyard's shared updater/agent-load.in, which the postinstall already runs.
#   - /LICENSE.txt, which every pre-flag-day pkg installed at the ROOT of the disk by mistake (the
#     license now installs under /usr/local/share/doc): removed HERE, but only if it is provably ours.
#     A file of that name at the root of someone's disk could be anyone's, so it goes only when the
#     old receipt lists it AND its bytes are exactly the license we ship; otherwise it is left alone.
#   - the old receipt: forgotten here, after the check above (which needs it).
# Scoped to Installer's target volume ($3): with none, nothing is known about where the old install
# lives, so nothing is done. Best-effort: never fail the install over any of it.
OLD_ID=dev.modernmavericks.swift-runtime
[ -n "${3:-}" ] || exit 0
VOL="$3"
ROOT="${VOL%/}"
OURS="$(dirname "$0")/LICENSE.txt"

if [ -f "$ROOT/LICENSE.txt" ] && [ ! -L "$ROOT/LICENSE.txt" ] && [ -f "$OURS" ] \
   && pkgutil --volume "$VOL" --files "$OLD_ID" 2>/dev/null | grep -Eqx '(\./)?LICENSE\.txt' \
   && cmp -s "$ROOT/LICENSE.txt" "$OURS"; then
  rm -f "$ROOT/LICENSE.txt" 2>/dev/null || true
fi

pkgutil --volume "$VOL" --forget "$OLD_ID" >/dev/null 2>&1 || true
exit 0
